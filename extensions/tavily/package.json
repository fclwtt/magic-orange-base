{
  "name": "@mo/tavily-plugin",
  "version": "2026.6.11",
  "description": "OpenClaw Tavily plugin",
  "type": "module",
  "dependencies": {
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@mo/plugin-sdk": "workspace:*"
  },
  "mo": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "clawhubSpec": "clawhub:@mo/tavily-plugin",
      "npmSpec": "@mo/tavily-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.9",
      "allowInvalidConfigRecovery": true
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "moVersion": "2026.6.11",
      "bundledDist": false
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mo/mo"
  }
}
