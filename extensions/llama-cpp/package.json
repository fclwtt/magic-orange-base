{
  "name": "@mo/llama-cpp-provider",
  "version": "2026.6.11",
  "description": "OpenClaw llama.cpp embedding provider plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/mo/mo"
  },
  "type": "module",
  "optionalDependencies": {
    "node-llama-cpp": "3.18.1"
  },
  "devDependencies": {
    "@mo/plugin-sdk": "workspace:*"
  },
  "mo": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@mo/llama-cpp-provider",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.6.2"
    },
    "compat": {
      "pluginApi": ">=2026.6.11"
    },
    "build": {
      "moVersion": "2026.6.11"
    },
    "release": {
      "bundleRuntimeDependencies": false,
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
