# Magic Orange Base 环境变量配置

# LLM 提供商 API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# 数据库配置
MO_DATABASE_URL=file:./data/magic-orange.db

# 日志级别
MO_LOG_LEVEL=info

# 服务器配置
MO_PORT=3000
MO_HOST=localhost

# 安全配置
MO_SECRET_KEY=your_secret_key_here

# 可选：Web 搜索
DUCKDUCKGO_SEARCH_ENABLED=true

# 可选：浏览器自动化
BROWSER_ENABLED=false
