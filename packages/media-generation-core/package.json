{
  "name": "@mo/media-generation-core",
  "version": "0.0.0-private",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./capability-model-ref": {
      "import": "./src/capability-model-ref.ts",
      "default": "./src/capability-model-ref.ts"
    },
    "./catalog": {
      "import": "./src/catalog.ts",
      "default": "./src/catalog.ts"
    },
    "./model-ref": {
      "import": "./src/model-ref.ts",
      "default": "./src/model-ref.ts"
    },
    "./normalization": {
      "import": "./src/normalization.ts",
      "default": "./src/normalization.ts"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/capability-model-ref.ts src/catalog.ts src/model-ref.ts src/normalization.ts --no-config --platform node --format esm --dts --out-dir dist --clean"
  }
}
